# Server environment only. Never use NEXT_PUBLIC_ names for credentials.
HF_MODEL_ID=YOUR_PERSONAL_ACCOUNT/YOUR_PRIVATE_MODEL
HF_MODEL_SUBDIR=bundle
HF_MODEL_REVISION=EXACT_40_CHARACTER_COMMIT_SHA_AFTER_UPLOAD
# HF_TOKEN=configure through your server secret manager, not this file
# FORECAST_API_KEY=optional separate server-to-server key
MAX_CONCURRENT_PREDICTIONS=1
PREDICTION_TIMEOUT_SECONDS=10
