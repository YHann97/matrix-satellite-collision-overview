# Matrix — Satellite Collision Overview
# Environment Configuration Template

# -----------------------------------------------------------------------------
# Supabase Configuration
# -----------------------------------------------------------------------------
# Found in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key
SUPABASE_SECRET_KEY=your-supabase-service-role-or-secret-key

# -----------------------------------------------------------------------------
# Mapbox GL JS Configuration
# -----------------------------------------------------------------------------
# Create a free public token at https://account.mapbox.com/
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.eyJ1IjoieW91ci11c2VybmFtZSIsImEiOiJ5b3VyLXRva2VuIn0.example
NEXT_PUBLIC_MAPBOX_STYLE_URL=mapbox://styles/mapbox/dark-v11

# -----------------------------------------------------------------------------
# External Prediction Server Configuration
# -----------------------------------------------------------------------------
# Leave empty for clearly labeled built-in SIMULATION (no hosting setup).
# Set full endpoint to use the trained backend; configured failures remain visible.
# Example: http://127.0.0.1:7860/v1/predict
PREDICTION_API_URL=
# Optional application auth (X-API-Key), matching backend FORECAST_API_KEY.
PREDICTION_API_KEY=
# Optional private Hugging Face gateway auth. Never use a NEXT_PUBLIC_ variable.
HF_TOKEN=
PREDICTION_TIMEOUT_MS=15000
